datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id           String   @id @default(uuid())
  name         String
  reference    String   @unique
  description  String?
  category     String
  quantity     Int      @default(0)
  minThreshold Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}